{
  "name": "drone-simulator",
  "version": "2.0.0",
  "description": "6-DOF Quadrotor Simulator with real-time PID tuning and 3D visualization",
  "author": "Drone Simulator",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "electron .",
    "preview": "npm run build && electron .",
    "lint": "next lint",
    "package": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "@react-three/drei": "^9.105.0",
    "@react-three/fiber": "^8.16.0",
    "axios": "^1.20.0",
    "cannon-es": "^0.20.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "next": "14.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "recharts": "^2.12.0",
    "tailwind-merge": "^2.3.0",
    "three": "^0.164.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.164.0",
    "autoprefixer": "^10.4.0",
    "electron": "^30.0.0",
    "electron-builder": "^24.0.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.4.0"
  },
  "build": {
    "appId": "com.drone-simulator.app",
    "productName": "Drone Simulator",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "portable",
      "icon": "public/favicon.png"
    },
    "extraFiles": [
      {
        "from": "ffmpeg/ffmpeg.dll",
        "to": "ffmpeg.dll"
      }
    ]
  }
}
